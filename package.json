    "sync": "node scripts/sync-albums.mjs",
    "images": "node scripts/responsive-images.mjs",
    "optimize": "node scripts/optimize-images.mjs",
    "new-album": "node scripts/new-album.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.121.5",
    "@react-three/fiber": "8.17.14",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.1",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
