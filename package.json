{
  "name": "estructuras-del-pacifico",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run sync && vite build && vite build --mode admin && vite build --ssr src/entry-server.jsx && node scripts/prerender.mjs",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "sync": "node scripts/sync-albums.mjs",
    "optimize": "node scripts/optimize-images.mjs",
    "new-album": "node scripts/new-album.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "framer-motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
